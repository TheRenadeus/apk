{
  "name": "mis-cuentas",
  "version": "1.0.0",
  "private": true,
  "description": "Control de finanzas personales como PWA y app Android (Capacitor)",
  "scripts": {
    "build": "node scripts/copy-web.mjs",
    "sync": "npm run build && npx cap sync android",
    "android": "npm run sync && npx cap open android",
    "icons": "npx @capacitor/assets generate --android --iconBackgroundColor '#3D5A80' --splashBackgroundColor '#EDF1EF'"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@aparajita/capacitor-biometric-auth": "^10.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2"
  },
  "homepage": "https://TU_USUARIO.github.io/mis-cuentas/"
}